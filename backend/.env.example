# Sentri — backend environment variables
# Only the vars you need to set are listed here. Everything else has sensible
# defaults. Full reference: docs/guide/env-vars.md

# ─── AI Provider (set at least one) ──────────────────────────────────────────
# Auto-detect order: Anthropic → OpenAI → Google → OpenRouter → Ollama
# Force a specific provider: AI_PROVIDER=anthropic | openai | google | openrouter | local
# AI_PROVIDER=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash
# OpenRouter — unified gateway to 200+ models (Claude, GPT, Llama, Mixtral, …)
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/auto                              # or e.g. anthropic/claude-3.5-sonnet
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1              # override for self-hosted proxy
# OPENROUTER_REFERER=https://sentri.dev                         # leaderboard attribution (optional)
# OPENROUTER_APP_TITLE=Sentri                                   # leaderboard attribution (optional)
# Ollama — local inference (set AI_PROVIDER=local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral:7b
# OLLAMA_MAX_PREDICT=4096
# OLLAMA_TIMEOUT_MS=120000
# Allow compat (`compat:<id>`) provider baseUrl to point at loopback / RFC1918
# / link-local addresses (self-hosted vLLM, LiteLLM, LocalAI). Do not enable
# in multi-tenant deployments.
# ALLOW_PRIVATE_URLS=false
# In-memory compat-provider config cache TTL (ms). Redis pub/sub invalidation
# is broadcast on `sentri:compat-config:invalidate` when REDIS_URL is set.
# COMPAT_CONFIG_CACHE_TTL_MS=60000

# ─── AI Provider — capability probe (PR #28) ─────────────────────────────────
# Default timeout (ms) for `/settings/ai-providers/:id/probe` and the
# auto-probe-on-upsert path. Per-route override lives on `provider_routes
# .probeTimeoutMs` (Migration 060) and takes precedence over this default.
# Clamped to [1s, 5min]. Raise for slow free-tier providers (OpenRouter
# `:free`, Gemini free tier can queue 30–90s during peak load).
# AI_PROBE_TIMEOUT_MS=30000

# ─── AI Provider — secrets (B3.x) ────────────────────────────────────────────
# Raw 32-byte master key (base64) used to AES-256-GCM encrypt provider API
# keys at rest. REQUIRED in production — when unset, a deterministic dev
# key is used and the server logs a loud warning at boot. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SENTRI_MASTER_KEY=

# ─── LLM retry / tokens ──────────────────────────────────────────────────────
# LLM_MAX_RETRIES=3
# LLM_BASE_DELAY_MS=2000
# LLM_MAX_BACKOFF_MS=30000
# LLM_MAX_TOKENS=16384

# ─── AI request log (B2.5) ───────────────────────────────────────────────────
# Single-tenant fallback storage mode. Per-workspace settings (configured via
# Settings UI) always win over this env var.
#   none     — metadata only (default; prompt + response are NULL)
#   redacted — built-in PII patterns stripped before persist
#   full     — raw prompt + response stored (replay requires this)
# AI_REQUEST_LOG_STORAGE_MODE=none
# Daily 04:45 UTC sweep deletes ai_request_log rows older than this many
# days. Set 0 to disable retention entirely.
# AI_REQUEST_LOG_RETENTION_DAYS=30

# ─── AI providers audit log (B3.9) ───────────────────────────────────────────
# Daily 05:00 UTC sweep deletes provider_route_audit rows older than this
# many days. Set 0 to disable retention. Distinct from AUDIT_RETENTION_DAYS.
# AI_ROUTES_AUDIT_RETENTION_DAYS=90

# ─── AI spend alert webhook (B4.0.1) ─────────────────────────────────────────
# Minimum interval (ms) between successive spend-cap webhook fires for the
# same workspace. Cooldown timestamp lives on workspaces.spendAlertLastFiredAt.
# SPEND_ALERT_COOLDOWN_MS=3600000

# ─── Demo mode (zero-config trial) ───────────────────────────────────────────
# When DEMO_GOOGLE_API_KEY is set, users without their own AI key can try
# Sentri using the shared key, subject to per-user daily quotas.
# DEMO_GOOGLE_API_KEY=
# DEMO_DAILY_CRAWLS=2
# DEMO_DAILY_RUNS=3
# DEMO_DAILY_GENERATIONS=5

# ─── AI chat ─────────────────────────────────────────────────────────────────
# MAX_CONVERSATION_TURNS=20
# AI_CLASSIFY_THRESHOLD=40

# ─── Database (INF-001) ───────────────────────────────────────────────────────
# By default Sentri uses SQLite (data/sentri.db) — no config needed.
# To use PostgreSQL, set DATABASE_URL to a postgres:// connection string:
# DATABASE_URL=postgres://sentri:sentri@localhost:5432/sentri
# PostgreSQL requires: npm install pg pg-native
# Pool size (default 10): PG_POOL_SIZE=10

# ─── Hosted deployment (Render/Fly/Railway) ───────────────────────────────────
# Free-tier root filesystems are ephemeral. Persist SQLite by mounting a disk
# and pointing DB_PATH to that mount (Render Blueprint uses /app/backend/data).
# DB_PATH=/app/backend/data/sentri.db
#
# Alternative: use managed Postgres (recommended for multi-instance production).
# When DATABASE_URL is set to postgres://... Sentri automatically uses Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/sentri

# ─── Redis (INF-002) ──────────────────────────────────────────────────────────
# Optional. When set, enables Redis-backed rate limiting, token revocation,
# and cross-instance SSE pub/sub. Without Redis, in-memory stores are used.
# REDIS_URL=redis://localhost:6379
# Redis requires: npm install ioredis
# For Redis-backed rate limiting also install: npm install rate-limit-redis

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# NODE_ENV=production
# CORS_ORIGIN=http://localhost:3000   # Required in production
# DB_PATH=data/sentri.db

# ─── Logging ──────────────────────────────────────────────────────────────────
# Minimum severity to print: debug | info | warn | error (default: info)
# LOG_LEVEL=info
# Timestamp format: iso (default) | utc | local | epoch
# LOG_DATE_FORMAT=iso
# IANA timezone for "local" format, e.g. America/New_York (default: system)
# LOG_TIMEZONE=
# Emit structured JSON lines on stdout instead of human-readable text
# LOG_JSON=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# CREDENTIAL_SECRET=                  # falls back to JWT_SECRET when unset
ARTIFACT_SECRET=
# ARTIFACT_TOKEN_TTL_MS=3600000
# ENABLE_DEV_RESET_TOKENS=false       # dev/test only — never in production
# APP_URL=http://localhost:3000
# APP_BASE_PATH=/
# BACKEND_URL=                        # auto-detected when unset

# ─── Email (SEC-001 — email verification + future notifications) ──────────────
# Option A: Resend (recommended) — set RESEND_API_KEY
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Option B: SMTP — set SMTP_HOST + SMTP_PORT (+ optional SMTP_USER, SMTP_PASS)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Sender address for all transactional emails:
# EMAIL_FROM=Sentri <noreply@sentri.dev>
# If neither Resend nor SMTP is configured, emails are logged to console (dev only).
# Skip email verification on registration (dev/CI only — never set in production):
# SKIP_EMAIL_VERIFICATION=true

# ─── BullMQ Job Queue (INF-003) ────────────────────────────────────────────────
# When REDIS_URL is set and `bullmq` is installed, run execution is routed
# through a durable BullMQ queue. Without it, runs execute in-process.
# MAX_WORKERS controls the global concurrency limit for run execution (default 2).
# MAX_WORKERS=2
# Requires: npm install bullmq (and REDIS_URL set above)

# ─── Auto-approval kill-switch (AUTO-003b) ────────────────────────────────────
# Global override for the confidence-based auto-approval pipeline. When set to
# any truthy value (1, true, yes — case-insensitive), every generated test
# lands in Draft regardless of the project's autoApproveThreshold. Intended
# for ops incidents where a bad AI provider is producing tests faster than
# reviewers can revoke them — setting this + restarting is a one-step
# rollback with no code deploy. Per-project thresholds stay intact and
# re-activate as soon as the env var is cleared.
# DISABLE_AUTO_APPROVAL=true

# ─── Test Retry (AUTO-005) ────────────────────────────────────────────────────
# Automatic per-test retries before marking a test failed (default 2, max 10).
# Set to 0 to disable retries entirely. No external dependencies.
# NOTE: only the FINAL attempt's video / screenshots / trace are preserved on
# disk — earlier attempts' artifacts are overwritten because each retry
# reuses the same `(runId, stepIndex)` artifact paths. The DB still records
# `retryCount` + `failedAfterRetry` accurately. See the JSDoc on
# `backend/src/runner/retry.js` § "Artifact overwrite behaviour" for details.
# MAX_TEST_RETRIES=2

# ─── SPA Nonce Injection (SEC-002) ─────────────────────────────────────────────
# Path to the Vite-built index.html for CSP nonce injection. Only needed when
# the frontend dist is not at the default location (../frontend/dist/index.html
# relative to the backend source). In Docker multi-container deployments, mount
# the frontend dist into the backend container and set this path.
# SPA_INDEX_PATH=/usr/share/frontend/index.html

# ─── OAuth (optional) ────────────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/login?provider=google
# APP_URL=http://localhost:3000

# ─── Telemetry (DIF-013) ─────────────────────────────────────────────────────
# Anonymous product telemetry (PostHog).
# Set SENTRI_TELEMETRY=0 or DO_NOT_TRACK=1 to disable fully.
# POSTHOG_API_KEY=phc_xxx
# POSTHOG_HOST=https://us.i.posthog.com
# SENTRI_TELEMETRY=1
# DO_NOT_TRACK=0

# ─── Object Storage (MNT-006) ───────────────────────────────────────────────
# Default (unset/local): artifacts are written to local ./artifacts directory.
# Set STORAGE_BACKEND=s3 to store artifacts in an S3-compatible object store
# (AWS S3, Cloudflare R2, MinIO, etc.).
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional custom endpoint for S3-compatible providers (R2/MinIO):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# AUTO-015 deployment webhooks
VERCEL_WEBHOOK_SECRET=
NETLIFY_WEBHOOK_SECRET=

# ─── GitHub PR Check Runs (INT-002) ──────────────────────────────────────────
# Required to post native Check Runs on GitHub PRs. Per-project opt-in via
# Settings → Integrations; the env vars below provide the App credentials
# Sentri uses to exchange installation tokens.
#   1. GITHUB_APP_ID — numeric App ID from the GitHub App settings page
#   2. GITHUB_APP_PRIVATE_KEY — PEM private key. For multi-line values in .env
#      files, escape newlines as `\n` (the loader unescapes them at runtime).
#   3. GITHUB_WEBHOOK_SECRET — HMAC-SHA256 secret for `X-Hub-Signature-256`
#      verification on `POST /api/v1/projects/:id/trigger/github`.
#   4. GITHUB_APP_SLUG — URL-safe slug of the GitHub App (the value at the
#      end of github.com/apps/<slug>). Required for the OAuth-style install
#      flow (`GET /api/v1/integrations/github/install/start/:projectId`).
#      `GITHUB_APP_NAME` is accepted as a fallback alias.
#   5. GITHUB_CHECK_NAME (optional) — display name on the PR (default "Sentri QA").
#   6. GITHUB_API_BASE (optional) — override for GitHub Enterprise Server.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n…\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=
# GITHUB_CHECK_NAME=Sentri QA
# GITHUB_API_BASE=https://api.github.com

# ─── Compliance audit log (SEC-007) ──────────────────────────────────────────
# The `activities` table is the workspace's compliance audit log. SOC 2 / ISO
# 27001 / PCI-DSS require it to be immutable, retained, tamper-evident, and
# its own reads to be audited. Every var below is off / safe by default.
#
# DANGER_ALLOW_AUDIT_PURGE — when "true", DELETE /api/v1/data/activities is
#   permitted (admin-gated). Default: "false" → the endpoint returns 403
#   AUDIT_PURGE_DISABLED. Only flip in dev or under explicit incident process.
DANGER_ALLOW_AUDIT_PURGE=false
#
# AUDIT_HASH_CHAIN — when "true", every audit row's prevHash is computed as
#   sha256(prevHash_{n-1} ++ JSON.stringify(rowMinusHash_n)) and persisted in
#   the same transaction as the INSERT. GET /api/v1/audit/verify walks the
#   chain and reports tampering. Off by default because chained writes
#   serialise INSERTs under contention — enable only on low-volume, compliance-
#   sensitive deployments.
AUDIT_HASH_CHAIN=false
#
# AUDIT_RETENTION_DAYS — daily sweep deletes activity rows older than this.
#   Default: 365 (SOC 2 CC7.2 baseline).
#   0      = retention disabled (never delete).
#   < 90   = REJECTED at boot (below SOC 2 / ISO 27001 minimum).
AUDIT_RETENTION_DAYS=365
#
# AUDIT_EXPORT_RATE_LIMIT — per (workspace × admin) export budget per 15 min.
#   Anti-exfiltration guard on CSV/NDJSON exports — JSON browsing is exempt.
#   Default: 10 (generous for legitimate evidence requests, tight enough that
#   a scripted full-table pull lights up the rate-limit + meta-audit logs).
# AUDIT_EXPORT_RATE_LIMIT=10
#
# AUDIT_DEDUP_WINDOW_SEC — industry-standard audit-log event dedup window
#   for read-shaped events (audit.read, audit.export, auth.login.failed).
#   Within this window, consecutive identical events collapse into a single
#   row with `count++` and `lastAt = now` — matching Splunk / CloudTrail /
#   Auth0 / Datadog convention. PCI-DSS 10.5.3 permits this provided
#   attribution is preserved (every event is still counted).
#   Default: 60 (seconds). Set to `0` to disable dedup entirely (every event
#   becomes its own row). Automatically disabled when `AUDIT_HASH_CHAIN=true`
#   (mutating a persisted row would invalidate its prevHash).
AUDIT_DEDUP_WINDOW_SEC=60

# ─── Observability (INF-007) ─────────────────────────────────────────────────
# All optional — every var is a no-op when unset.
#
# OTEL_EXPORTER_OTLP_ENDPOINT: when set, the backend boots an OpenTelemetry
#   SDK that exports traces via OTLP/HTTP to the configured collector
#   (Jaeger, Tempo, Datadog, Honeycomb, etc.). Unset = OTel SDK is a no-op.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=sentri-backend
#
# METRICS_SCRAPE_KEY: Bearer token required to scrape GET /metrics
#   (Prometheus exposition format). When unset, /metrics returns 401 to
#   every request — i.e. the endpoint is effectively disabled until you
#   set a token. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# METRICS_SCRAPE_KEY=
#
# SENTRY_DSN: optional backend crash-reporting target (sentry.io or
#   self-hosted Sentry). Unset = Sentry SDK is a no-op (no network calls).
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ─── Per-workspace AI rate limiting (MNT-015) ────────────────────────────────
# Single per-workspace token bucket scoped to AI mutation routes only.
# Mounted (POST-only) on `POST /chat`, `POST /projects/:id/crawl`,
# `POST /projects/:id/tests/generate`, `POST /tests/:testId/fix`,
# `POST /settings/agent-roles/:role/test`. Each matched POST consumes 10
# cost units; non-AI routes (auth, SSE, /health, every GET/PATCH/DELETE)
# bypass this limiter entirely and are NOT metered against the budget.
# Industry pattern (Vercel AI Gateway / Cursor / OpenRouter): one key, one cap.
# AI_RATE_LIMIT_PER_MIN=300                # cost units/minute (default = 30 AI mutations / minute / workspace)
# AI_RATE_LIMIT_WINDOW_SEC=60
# Legacy: AI_RATE_LIMIT_REGULAR_PER_MIN was a second cap; removed in favour of
# the single-cap design above. The env var is silently ignored if set.

# ─── Test execution ───────────────────────────────────────────────────────────
# BROWSER_HEADLESS=true                # set false to see the browser window
# VIEWPORT_WIDTH=1280
# VIEWPORT_HEIGHT=720
# NAVIGATION_TIMEOUT=30000             # page.goto() timeout (ms)
# API_TEST_TIMEOUT=30000               # per-API-test timeout (ms)
# BROWSER_TEST_TIMEOUT=120000          # per-browser-test timeout guard (ms)
# PARALLEL_WORKERS=1                   # concurrent browser contexts (1–10)
# BROWSER_POOL_SIZE=                       # warm browser slots per browser (default WORKER_CONCURRENCY / MAX_WORKERS)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# ─── Crawler ──────────────────────────────────────────────────────────────────
# CRAWL_MAX_PAGES=30
# CRAWL_MAX_DEPTH=3
# CRAWL_NETWORKIDLE_TIMEOUT=5000       # networkidle wait after page load (ms)

# ─── Self-healing ─────────────────────────────────────────────────────────────
# HEALING_ELEMENT_TIMEOUT=5000         # element finding timeout per strategy (ms)
# HEALING_RETRY_COUNT=3
# HEALING_RETRY_DELAY=400
# HEALING_HINT_MAX_FAILS=3
# HEALING_VISIBLE_WAIT_CAP=1200

# ─── BullMQ worker concurrency (AUTO-008) ─────────────────────────────────────
# Per-container concurrency for the BullMQ run worker. Used by both the
# in-process worker and the standalone `worker` Compose service. Falls
# back to MAX_WORKERS when unset.
# WORKER_CONCURRENCY=2

# ─── DB write-batching queue (B1.2 — AUDIT-ROADMAP Bundle 1) ─────────────────
# Batches the hottest SQLite write paths (run_test_results, run_logs,
# healing_history) inside a single transaction to lift effective
# throughput under `parallelWorkers > 1`. PostgreSQL deployments
# passthrough — no batching. The graceful-shutdown hook drains the queue
# before `closeDatabase()` so a planned SIGTERM loses nothing.
# DB_WRITE_BATCH_SIZE=50                # ops per flush (size trigger)
# DB_WRITE_FLUSH_MS=100                 # time trigger (ms)

# ─── Run crash recovery (B1.1 — AUDIT-ROADMAP Bundle 1) ──────────────────────
# Run-startup sweep: any run still flagged `status='running'` with no
# per-test result flush in the last CHECKPOINT_STALE_MS window is
# transitioned to `status='failed', failureReason='process_crash'`. Pair
# with `POST /api/v1/runs/:id/resume` to re-enqueue only the tests that
# never made it to `run_test_results`. Default mirrors the existing
# orphan-recovery scan in `index.js`.
# CHECKPOINT_STALE_MS=60000

# ─── SPA hydration + adaptive timeout (B2 — AUDIT-ROADMAP Bundle 2) ──────────
# HYDRATION_WAIT_MS — max wait for SPA loading indicators to clear before
# snapshotting. React/Vue/Angular/Next.js apps populate the interactive DOM
# 200–2 000 ms after `domcontentloaded`. The wait is best-effort: apps
# without a recognisable loading indicator fall through after this many ms
# and the crawl proceeds unchanged. Per-project override:
# `project.hydrationType = 'custom'` + `hydrationSelector` (operator
# supplies the selector to wait for). `'domcontentloaded'` opts out
# entirely. Default 5 000 ms.
# HYDRATION_WAIT_MS=5000
#
# MAX_ELEMENT_TIMEOUT — ceiling on the per-run adaptive element timeout
# computed by `testRunner.js` from `2 * p95(crawl_snapshots.loadMs)`.
# Without a ceiling, a single slow outlier page would bloat the per-action
# wait into the multi-minute range and let runaway tests sit blocked on
# a single locator. Per-project escape hatch:
# `project.elementTimeoutOverride` (bypasses the adaptive calculation
# entirely). Default 30 000 ms.
# MAX_ELEMENT_TIMEOUT=30000

# ─── Auth-session recovery + target-app TOTP (B4 — AUDIT-ROADMAP Bundle 4) ───
# AUTH_REDIRECT_PATTERNS — JSON-encoded array of regex source strings.
# Extends the built-in URL patterns the runner uses to detect a session-
# expired redirect mid-run (`/login`, `/signin`, `/auth`,
# `/session-expired`, `/unauthorized`). Set this when your SUT's expiry
# redirects to a custom path that doesn't match the defaults. Each
# pattern is compiled case-insensitively; bad entries emit a warning
# at module load (not a boot failure) so a typo can't take down the
# server. Example:
#   AUTH_REDIRECT_PATTERNS=["/auth/expired","/sso/relogin"]
# AUTH_REDIRECT_PATTERNS=
