{
  "name": "sentri-backend",
  "version": "1.9.1",
  "type": "module",
  "scripts": {
    "start": "node --import ./src/otel-preload.mjs src/index.js",
    "dev": "node --import ./src/otel-preload.mjs --watch-path=src src/index.js",
    "worker": "node --import ./src/otel-preload.mjs src/worker.js",
    "test": "node tests/run-tests.js",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "docs": "jsdoc -c jsdoc.json",
    "docs:watch": "nodemon --watch src -e js --exec 'npm run docs'",
    "postinstall": "node scripts/copy-trace-viewer.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@google/generative-ai": "^0.24.0",
    "@playwright/test": "^1.58.2",
    "acorn": "^8.14.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.50.1",
    "pngjs": "^7.0.0",
    "source-map": "^0.7.4",
    "uuid": "^11.0.5",
    "v8-to-istanbul": "^9.3.0",
    "@axe-core/playwright": "^4.10.2",
    "web-vitals": "^4.2.4",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "prom-client": "^15.1.3",
    "@sentry/node": "^8.33.1",
    "@opentelemetry/api": "^1.9.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@simplewebauthn/server": "^11.0.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pg-native": "^3.2.0",
    "posthog-node": "^4.12.0",
    "rate-limit-redis": "^4.2.0"
  },
  "devDependencies": {
    "jsdoc": "^4.0.4"
  }
}
